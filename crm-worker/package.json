{
  "name": "market-imobi-crm-worker",
  "version": "0.1.0",
  "description": "Market Imobi CRM — Cloudflare Worker (staging)",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "d1:migrate:local": "wrangler d1 migrations apply market-imobi-staging --local",
    "d1:migrate:remote": "wrangler d1 migrations apply market-imobi-staging --remote",
    "d1:export": "wrangler d1 export market-imobi-staging --remote --output ./backup/staging-$(date +%Y%m%d-%H%M%S).sql",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.87.0"
  }
}
